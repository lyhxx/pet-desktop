<Window x:Class="DesktopPet.UI.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="状态"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Focusable="False">

    <StackPanel Orientation="Vertical" Margin="6">
        <StackPanel.Effect>
            <DropShadowEffect Color="#201008" BlurRadius="4" ShadowDepth="0" Opacity="0.7" />
        </StackPanel.Effect>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="🍚" FontFamily="Segoe UI Emoji" FontSize="15" VerticalAlignment="Center" />
            <TextBlock x:Name="HungerText" Margin="4,0,0,0" VerticalAlignment="Center"
                       FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="😊" FontFamily="Segoe UI Emoji" FontSize="15" VerticalAlignment="Center" />
            <TextBlock x:Name="MoodText" Margin="4,0,0,0" VerticalAlignment="Center"
                       FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
        </StackPanel>
    </StackPanel>
</Window>
