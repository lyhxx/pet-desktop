<Window x:Class="DesktopPet.UI.OutfitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="装扮"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent" Padding="22,18,16,10"
                        MouseLeftButtonDown="OnHeaderDrag">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}"
                                Click="OnClose" Content="✕" />
                        <TextBlock Text="装扮" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="22,4,22,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="帽子" Style="{StaticResource LabelText}" />
                        <ComboBox Grid.Column="1" x:Name="HatCombo" Style="{StaticResource SlimComboBox}"
                                  SelectionChanged="OnSelectionChanged" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="眼镜" Style="{StaticResource LabelText}" />
                        <ComboBox Grid.Column="1" x:Name="GlassesCombo" Style="{StaticResource SlimComboBox}"
                                  SelectionChanged="OnSelectionChanged" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="围巾" Style="{StaticResource LabelText}" />
                        <ComboBox Grid.Column="1" x:Name="ScarfCombo" Style="{StaticResource SlimComboBox}"
                                  SelectionChanged="OnSelectionChanged" />
                    </Grid>

                    <TextBlock Text="选择后立即生效" Style="{StaticResource MutedText}" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
