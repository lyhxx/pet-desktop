<Window x:Class="DesktopPet.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent" Padding="22,18,16,10"
                        MouseLeftButtonDown="OnHeaderDrag">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}"
                                Click="OnCancel" Content="✕" />
                        <TextBlock Text="设置" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="22,4,22,22">
                    <TextBlock Text="程序" Style="{StaticResource SectionText}" />
                    <CheckBox x:Name="StartupCheck" Style="{StaticResource PillCheckBox}" Content="开机启动" Margin="0,3" />
                    <CheckBox x:Name="TopmostCheck" Style="{StaticResource PillCheckBox}" Content="始终置顶" Margin="0,3" />
                    <CheckBox x:Name="SoundCheck" Style="{StaticResource PillCheckBox}" Content="声音开关" Margin="0,3" />
                    <CheckBox x:Name="VisibleCheck" Style="{StaticResource PillCheckBox}" Content="显示宠物" Margin="0,3" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="宠物大小" Style="{StaticResource LabelText}" />
                        <ComboBox Grid.Column="1" x:Name="SizeCombo" Style="{StaticResource SlimComboBox}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="音量" Style="{StaticResource LabelText}" />
                        <Slider Grid.Column="1" x:Name="VolumeSlider" Style="{StaticResource SlimSlider}"
                                Minimum="0" Maximum="1" />
                    </Grid>

                    <DockPanel Margin="0,18,0,0">
                        <Button DockPanel.Dock="Right" Content="检查更新"
                                Style="{StaticResource GhostButton}" Click="OnCheckUpdate" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Click="OnCancel" Margin="0,0,10,0" />
                        <Button Content="保存" Style="{StaticResource RoundedButton}" Click="OnSave" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
