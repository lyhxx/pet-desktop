<Window x:Class="DesktopPet.UI.PetMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单"
        Width="126"
        Height="224"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Focusable="False">

    <Canvas x:Name="Root" Width="126" Height="224" Background="Transparent">
        <!-- 主菜单 -->
        <Button x:Name="FeedButton" Style="{StaticResource CircleButton}" Click="OnFeed"
                ToolTip="喂食" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="5000">
            <TextBlock Text="🍚" FontFamily="Segoe UI Emoji" FontSize="20" />
        </Button>
        <Button x:Name="PetButton" Style="{StaticResource CircleButton}" Click="OnPet"
                ToolTip="摸摸" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="5000">
            <TextBlock Text="❤" FontFamily="Segoe UI Emoji" FontSize="19" />
        </Button>
        <Button x:Name="OutfitButton" Style="{StaticResource CircleButton}" Click="OnOutfit"
                ToolTip="装扮" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="5000">
            <TextBlock Text="🎩" FontFamily="Segoe UI Emoji" FontSize="19" />
        </Button>
        <Button x:Name="SettingsButton" Style="{StaticResource CircleButton}" Click="OnSettings"
                ToolTip="设置" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="5000">
            <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="19" />
        </Button>
        <Button x:Name="HideButton" Style="{StaticResource CircleButton}" Click="OnHide"
                ToolTip="隐藏" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="5000">
            <TextBlock Text="👁" FontFamily="Segoe UI Emoji" FontSize="18" />
        </Button>

        <!-- 食物子菜单 -->
        <Button x:Name="FishButton" Style="{StaticResource CircleButton}" Click="OnFish"
                Visibility="Collapsed" ToolTip="小鱼干" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="5000">
            <TextBlock Text="🐟" FontFamily="Segoe UI Emoji" FontSize="19" />
        </Button>
        <Button x:Name="KibbleButton" Style="{StaticResource CircleButton}" Click="OnKibble"
                Visibility="Collapsed" ToolTip="猫粮" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="5000">
            <TextBlock Text="🍚" FontFamily="Segoe UI Emoji" FontSize="20" />
        </Button>
        <Button x:Name="MilkButton" Style="{StaticResource CircleButton}" Click="OnMilk"
                Visibility="Collapsed" ToolTip="牛奶" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="5000">
            <TextBlock Text="🥛" FontFamily="Segoe UI Emoji" FontSize="19" />
        </Button>
        <Button x:Name="BackButton" Style="{StaticResource CircleButton}" Click="OnBack"
                Visibility="Collapsed" ToolTip="返回" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="5000">
            <TextBlock Text="↩" FontFamily="Segoe UI Emoji" FontSize="18" />
        </Button>
    </Canvas>
</Window>
